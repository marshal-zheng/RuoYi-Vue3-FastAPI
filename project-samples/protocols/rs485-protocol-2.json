{
  "protocolName": "RS485协议-舵机状态反馈",
  "protocolType": "RS485",
  "status": "0",
  "description": "舵机控制器状态反馈协议，舵机控制器向飞控计算机上报当前状态",
  "protocolConfig": {
    "frequency": "100",
    "frequencyLabel": "100Hz",
    "speed": "115200",
    "speedLabel": "115200bps",
    "method": "半双工",
    "methodLabel": "半双工",
    "sendDuration": "5",
    "frameLength": "40",
    "errorHandle": "discard",
    "errorHandleLabel": "丢弃",
    "notes": "与RS485协议-舵机控制指令配对使用，舵机控制器收到指令后反馈执行状态",
    "fields": [
      {
        "id": "1",
        "parentId": null,
        "fieldName": "帧头",
        "byteCount": 2,
        "byteSequence": "0-1",
        "valueRange": "0x90EB",
        "unit": "",
        "dataType": "UINT16",
        "scale": "1",
        "remark": "反馈帧头，与指令帧头相反"
      },
      {
        "id": "2",
        "parentId": null,
        "fieldName": "帧计数",
        "byteCount": 2,
        "byteSequence": "2-3",
        "valueRange": "0-65535",
        "unit": "",
        "dataType": "UINT16",
        "scale": "1",
        "remark": "响应对应的指令帧计数"
      },
      {
        "id": "3",
        "parentId": null,
        "fieldName": "舵机地址",
        "byteCount": 1,
        "byteSequence": "4",
        "valueRange": "0x01=副翼,0x02=升降舵,0x03=方向舵,0x04=襟翼",
        "unit": "",
        "dataType": "UINT8",
        "scale": "1",
        "remark": "上报舵机编号"
      },
      {
        "id": "4",
        "parentId": null,
        "fieldName": "当前角度",
        "byteCount": 4,
        "byteSequence": "5-8",
        "valueRange": "-45~45",
        "unit": "°",
        "dataType": "FLOAT",
        "scale": "0.01",
        "remark": "舵面当前实际角度"
      },
      {
        "id": "5",
        "parentId": null,
        "fieldName": "角度偏差",
        "byteCount": 4,
        "byteSequence": "9-12",
        "valueRange": "-10~10",
        "unit": "°",
        "dataType": "FLOAT",
        "scale": "0.001",
        "remark": "目标角度与实际角度偏差"
      },
      {
        "id": "6",
        "parentId": null,
        "fieldName": "当前角速度",
        "byteCount": 4,
        "byteSequence": "13-16",
        "valueRange": "-100~100",
        "unit": "°/s",
        "dataType": "FLOAT",
        "scale": "0.1",
        "remark": "舵面当前转动速度"
      },
      {
        "id": "7",
        "parentId": null,
        "fieldName": "输出力矩",
        "byteCount": 2,
        "byteSequence": "17-18",
        "valueRange": "0~100",
        "unit": "%",
        "dataType": "UINT16",
        "scale": "1",
        "remark": "当前输出力矩百分比"
      },
      {
        "id": "8",
        "parentId": null,
        "fieldName": "电机温度",
        "byteCount": 2,
        "byteSequence": "19-20",
        "valueRange": "-40~150",
        "unit": "℃",
        "dataType": "INT16",
        "scale": "0.1",
        "remark": "舵机电机温度"
      },
      {
        "id": "9",
        "parentId": null,
        "fieldName": "母线电压",
        "byteCount": 2,
        "byteSequence": "21-22",
        "valueRange": "0~36",
        "unit": "V",
        "dataType": "UINT16",
        "scale": "0.01",
        "remark": "供电电压"
      },
      {
        "id": "10",
        "parentId": null,
        "fieldName": "母线电流",
        "byteCount": 2,
        "byteSequence": "23-24",
        "valueRange": "0~20",
        "unit": "A",
        "dataType": "UINT16",
        "scale": "0.01",
        "remark": "工作电流"
      },
      {
        "id": "11",
        "parentId": null,
        "fieldName": "状态字",
        "byteCount": 2,
        "byteSequence": "25-26",
        "valueRange": "Bit0=到位,Bit1=过载,Bit2=过温,Bit3=欠压,Bit4=通信故障",
        "unit": "",
        "dataType": "UINT16",
        "scale": "1",
        "remark": "舵机状态标志"
      },
      {
        "id": "12",
        "parentId": null,
        "fieldName": "故障码",
        "byteCount": 1,
        "byteSequence": "27",
        "valueRange": "0=正常,1=编码器故障,2=驱动故障,3=机械卡死",
        "unit": "",
        "dataType": "UINT8",
        "scale": "1",
        "remark": "故障诊断码"
      },
      {
        "id": "13",
        "parentId": null,
        "fieldName": "校验和",
        "byteCount": 1,
        "byteSequence": "28",
        "valueRange": "",
        "unit": "",
        "dataType": "UINT8",
        "scale": "1",
        "remark": "累加和校验"
      }
    ]
  }
}
