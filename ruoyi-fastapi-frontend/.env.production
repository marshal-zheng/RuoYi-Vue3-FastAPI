# 生产环境配置
ENV = 'production'

# 应用标题
VITE_APP_TITLE = XX系统总线设计仿真系统(扩充)

# 生产环境
VITE_APP_ENV = 'production'

# 生产环境禁用开发态菜单热同步
VITE_DEV_MENU_SYNC = '0'
VITE_DEV_MENU_SYNC_POLL_INTERVAL_MS = '30000'

# 生产环境 API 请求路径
VITE_APP_BASE_API = '/api'

# Mock 模式：fallback（真实接口优先）| pure（全 Mock）| off（禁用）
VITE_ENABLE_MOCK = 'off'
