# demo-offline 演示环境配置
VITE_APP_ENV = 'demo-offline'

# 应用标题
VITE_APP_TITLE = XX系统总线设计仿真系统(扩充)

# demo-offline 明确使用纯前端离线运行模式
VITE_APP_RUNTIME_MODE = 'demo-offline'
VITE_ENABLE_MOCK = 'pure'

# 静态演示环境仍使用统一 API 前缀，由 MSW 拦截处理
VITE_APP_BASE_API = '/api'

# 默认离线演示场景
VITE_DEMO_SCENARIO_ID = 'default'
VITE_DEMO_RUNTIME_DEBUG = 'true'

# 演示构建禁用开发态菜单热同步
VITE_DEV_MENU_SYNC = '0'
VITE_DEV_MENU_SYNC_MODE = 'off'
VITE_DEV_MENU_SYNC_POLL_INTERVAL_MS = '30000'

# 侧边栏标题字体大小
VITE_SIDEBAR_TITLE_FONT_SIZE = 16px
