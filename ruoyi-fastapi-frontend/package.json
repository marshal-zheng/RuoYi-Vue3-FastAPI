{
  "name": "vfadmin",
  "version": "1.6.2",
  "description": "vfadmin管理系统",
  "author": "insistence",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fallback": "cross-env VITE_APP_RUNTIME_MODE=fallback vite",
    "build:prod": "vite build",
    "build:demo-offline": "vite build --mode demo-offline",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "preview:demo-offline": "vite preview --mode demo-offline --host 127.0.0.1 --port 4173",
    "type-check": "vue-tsc --noEmit",
    "type-check:strict": "vue-tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint src/ --fix --max-warnings 0",
    "lint:check": "eslint src/ --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:browser": "vitest --browser",
    "test:browser:run": "vitest run --browser",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "e2e:demo-offline": "node scripts/run-demo-offline-e2e.mjs",
    "e2e:demo-offline:reuse": "node scripts/run-demo-offline-e2e.mjs --skip-build --base-url=http://127.0.0.1:4173",
    "e2e:demo-offline:page-state": "node scripts/run-demo-offline-e2e.mjs --config=playwright.demo-offline-page-state.config.ts --suite-name=page-state",
    "api:generate": "bash ../scripts/generate-api-types.sh",
    "api:generate:local": "bash ../scripts/generate-api-types.sh --live --backend-url http://localhost:8000",
    "mock:contracts": "node scripts/check-mock-contracts.mjs --strict",
    "mock:contracts:report": "node scripts/check-mock-contracts.mjs --strict --format=markdown",
    "mock:contracts:json": "node scripts/check-mock-contracts.mjs --strict --format=json",
    "mock:overlays": "node scripts/check-mock-overlays.mjs --strict",
    "mock:overlays:report": "node scripts/check-mock-overlays.mjs --strict --format=markdown",
    "mock:overlays:json": "node scripts/check-mock-overlays.mjs --strict --format=json",
    "ui:standards": "node scripts/check-ui-standards.mjs --strict && vitest run tests/ui-standards.test.ts tests/generator-form-contract.test.ts",
    "ui:standards:report": "node scripts/check-ui-standards.mjs --strict --format=markdown",
    "ui:standards:json": "node scripts/check-ui-standards.mjs --strict --format=json"
  },
