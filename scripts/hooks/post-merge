#!/bin/bash
# Git post-merge hook: pull代码后自动同步数据库
#
# 安装方法:
#   bash scripts/setup-hooks.sh
# 或手动:
#   cp scripts/hooks/post-merge .git/hooks/ && chmod +x .git/hooks/post-merge
#
# 功能：
#   当检测到 alembic/versions/ 目录有变更时，自动执行 alembic upgrade head

set -e

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 检查迁移文件是否有变更
MIGRATION_CHANGED=$(git diff --name-only HEAD@{1} HEAD -- 'ruoyi-fastapi-backend/alembic/versions/' 2>/dev/null || true)

if [ -n "$MIGRATION_CHANGED" ]; then
    echo ""
    echo -e "${YELLOW}========================================${NC}"
    echo -e "${YELLOW}[DevSync] 检测到数据库迁移文件变更${NC}"
    echo -e "${YELLOW}========================================${NC}"
    echo "变更文件:"
    echo "$MIGRATION_CHANGED"
    echo ""
    
    # 进入后端目录
    cd ruoyi-fastapi-backend
    
    # 检查是否安装了 alembic
    if ! command -v alembic &> /dev/null; then
        echo -e "${YELLOW}[DevSync] alembic 未安装，跳过自动同步${NC}"
        echo -e "${YELLOW}         请手动执行: pip install alembic && alembic upgrade head${NC}"
        cd ..
        exit 0
    fi
    
    # 执行迁移
    echo -e "${YELLOW}[DevSync] 执行 alembic upgrade head...${NC}"
    
    if alembic upgrade head; then
        echo -e "${GREEN}[DevSync] ✓ 数据库同步成功${NC}"
    else
        echo -e "${RED}[DevSync] ✗ 数据库同步失败${NC}"
        echo -e "${RED}         请检查迁移文件或手动执行: alembic upgrade head${NC}"
    fi
    
    cd ..
    echo -e "${YELLOW}========================================${NC}"
    echo ""
fi
