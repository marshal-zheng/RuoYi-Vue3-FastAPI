+it('reports handled Vue warnings and render failures without relying on browser console delivery', () => {
+  const feedback: { warnings: string[]; errors: string[] } = {
+    warnings: [],
+    errors: [],
+  }
+  const app = createApp(FeedbackProbe)
+  app.config.warnHandler = (message) => feedback.warnings.push(message)
+  app.config.errorHandler = (error) => feedback.errors.push(String(error))
+  Reflect.set(window, '__CONSUMER__', feedback)
+  const target = document.createElement('section')
+  document.body.appendChild(target)
+  app.mount(target)
+  dispose.push(() => {
+    app.unmount()
+    target.remove()
