+/** Serialize handled Vue feedback for the browser gate, independent of console delivery. */
+export function captureConsumerFeedback() {
+  if (!('__CONSUMER__' in window)) throw new Error('consumer-feedback-missing')
+  const feedback = window.__CONSUMER__
+  if (
+    !feedback ||
+    typeof feedback !== 'object' ||
+    !('warnings' in feedback) ||
+    !('errors' in feedback) ||
+    !Array.isArray(feedback.warnings) ||
+    !Array.isArray(feedback.errors)
+  )
+    throw new Error('consumer-feedback-invalid')
+  const warnings = feedback.warnings.map((warning) => {
+    if (typeof warning !== 'string')
+      throw new Error('consumer-feedback-invalid')
+    return warning
+  })
+  const errors = feedback.errors.map((error) => {
+    if (typeof error !== 'string') throw new Error('consumer-feedback-invalid')
+    return error
+  })
+  return { warnings, errors }
+}
