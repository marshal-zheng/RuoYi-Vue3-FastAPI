+    await vi.waitFor(() =>
+      expect(document.querySelector('.el-drawer')).not.toBeNull()
+    )
+    child = mount(ZxDialog, {
+      props: { modelValue: false, title: 'Child dialog' },
+      global,
+    })
+    await child.setProps({ modelValue: true })
+    await vi.waitFor(() => {
+      const drawer = document
+        .querySelector('.el-drawer')
+        ?.closest<HTMLElement>('.el-overlay')
+      const dialog = document
+        .querySelector('.el-dialog')
+        ?.closest<HTMLElement>('.el-overlay')
+      expect(Number(dialog?.style.zIndex)).toBeGreaterThan(
+        Number(drawer?.style.zIndex)
+      )
+    })
+  } finally {
+    child?.unmount()
+    parent.unmount()
+    await portal.dispose()
+  }
+})
 
