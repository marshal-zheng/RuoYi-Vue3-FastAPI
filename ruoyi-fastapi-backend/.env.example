# -------- 应用配置 --------
# 应用运行环境 (dev/test/prod)
APP_ENV = 'dev'
# 应用名称
APP_NAME = 'RuoYi-FastAPI'
# 应用代理路径
APP_ROOT_PATH = '/dev-api'
# 应用主机
APP_HOST = '0.0.0.0'
# 应用端口
APP_PORT = 8002
# 应用版本
APP_VERSION= '1.6.2'
# 应用是否开启热重载
APP_RELOAD = true
# 应用是否开启IP归属区域查询
APP_IP_LOCATION_QUERY = true
# 应用是否允许账号同时登录
APP_SAME_TIME_LOGIN = false

# -------- Jwt配置 --------
# Jwt秘钥 (请使用以下命令生成新的秘钥: openssl rand -hex 32)
JWT_SECRET_KEY = 'your-secret-key-here-please-change-it'
# Jwt算法
JWT_ALGORITHM = 'HS256'
# 令牌过期时间 (单位：分钟)
JWT_EXPIRE_MINUTES = 1440
# redis中令牌过期时间 (单位：分钟)
JWT_REDIS_EXPIRE_MINUTES = 30

# -------- 敏感数据加密 --------
# 是否启用敏感字段加密
SENSITIVE_DATA_ENABLED = true
# 敏感数据加密密钥（建议使用 32+ 位随机字符串）
SENSITIVE_DATA_KEY = ''
# 是否使用确定性加密（关闭后需配合 hash 列做查询）
SENSITIVE_DATA_DETERMINISTIC = false


# -------- 数据库配置 --------
# 数据库类型，可选的有'mysql'、'postgresql'，默认为'mysql'
DB_TYPE = 'mysql'
# 数据库主机
DB_HOST = '127.0.0.1'
# 数据库端口
DB_PORT = 3306
# 数据库用户名
DB_USERNAME = 'root'
# 数据库密码
DB_PASSWORD = 'your-password-here'
# 数据库名称
DB_DATABASE = 'ruoyi-fastapi'
# 是否开启sqlalchemy日志
DB_ECHO = true
# 允许溢出连接池大小的最大连接数
DB_MAX_OVERFLOW = 10
# 连接池大小，0表示连接数无限制
DB_POOL_SIZE = 50
# 连接回收时间（单位：秒）
DB_POOL_RECYCLE = 3600
# 连接池中没有线程可用时，最多等待的时间（单位：秒）
DB_POOL_TIMEOUT = 30

# -------- Redis配置 --------
# Redis主机
REDIS_HOST = '127.0.0.1'
# Redis端口
REDIS_PORT = 6379
# Redis用户名
REDIS_USERNAME = ''
# Redis密码
REDIS_PASSWORD = ''
# Redis数据库
REDIS_DATABASE = 2

# -------- 错误处理配置（双层消息设计）--------
# 是否在响应中包含开发者消息（开发环境=true，生产环境=false）
INCLUDE_DEVELOPER_MESSAGE = false
# 错误日志级别
ERROR_LOG_LEVEL = 'ERROR'
# 默认语言
DEFAULT_LANGUAGE = 'zh'

# -------- 日志配置 --------
# 是否启用 JSON 结构化日志输出
LOG_JSON_ENABLED = true
# 控制台日志级别
LOG_LEVEL = 'INFO'
# 错误文件日志级别
LOG_ERROR_FILE_LEVEL = 'ERROR'
# 错误日志滚动策略
LOG_ERROR_ROTATION = '50MB'
# 错误日志压缩格式
LOG_ERROR_COMPRESSION = 'zip'

# -------- 幂等配置 --------
# 幂等中间件总开关
IDEMPOTENCY_ENABLED = true
# 幂等响应缓存 TTL（秒）
IDEMPOTENCY_TTL_SECONDS = 600
# 幂等锁 TTL（秒）
IDEMPOTENCY_LOCK_TTL_SECONDS = 30
# 并发请求等待缓存超时（毫秒）
IDEMPOTENCY_WAIT_TIMEOUT_MS = 2000
# 生效方法（逗号分隔）
IDEMPOTENCY_METHODS = 'POST,PUT'
# 生效路径前缀（逗号分隔）
IDEMPOTENCY_PATH_PREFIXES = '/'
# 排除路径前缀（逗号分隔）
IDEMPOTENCY_EXCLUDE_PATHS = '/health,/ready,/metrics,/docs,/redoc,/openapi.json'
# 允许参与幂等处理的最大请求体（字节，超限将跳过缓存逻辑）
IDEMPOTENCY_MAX_REQUEST_BODY_BYTES = 2097152
# 允许缓存的最大响应体（字节）
IDEMPOTENCY_MAX_RESPONSE_BODY_BYTES = 2097152

# -------- 限流配置 --------
# 限流中间件总开关
RATE_LIMIT_ENABLED = true
# 计数窗口（秒）
RATE_LIMIT_WINDOW_SECONDS = 60
# 无需限流路径（逗号分隔）
RATE_LIMIT_EXCLUDE_PATHS = '/health,/ready,/docs,/redoc,/openapi.json,/metrics'
# 认证类接口路径（逗号分隔）
RATE_LIMIT_AUTH_PATHS = '/login,/captchaImage,/register'
# 写接口方法（逗号分隔）
RATE_LIMIT_WRITE_METHODS = 'POST,PUT,PATCH,DELETE'
# 可信代理（逗号分隔，支持 IP/CIDR；仅可信来源才解析 X-Forwarded-For）
RATE_LIMIT_TRUSTED_PROXIES = '127.0.0.1,::1'
# auth tier 限额（IP / user）
RATE_LIMIT_AUTH_IP = 20
RATE_LIMIT_AUTH_USER = 40
# write tier 限额（IP / user）
RATE_LIMIT_WRITE_IP = 120
RATE_LIMIT_WRITE_USER = 240
# read tier 限额（IP / user）
RATE_LIMIT_READ_IP = 600
RATE_LIMIT_READ_USER = 1200

# -------- OpenTelemetry 配置 --------
# 是否启用 OpenTelemetry 链路追踪
OTEL_ENABLED = true
# 服务名（resource.service.name）
OTEL_SERVICE_NAME = 'ruoyi-fastapi-backend'
# 服务命名空间（resource.service.namespace）
OTEL_SERVICE_NAMESPACE = 'ruoyi-fastapi'
# 采样率（0~1）
OTEL_TRACES_SAMPLE_RATIO = 1.0
# OTLP HTTP Trace 上报地址（留空则仅 Console 导出）
OTEL_OTLP_ENDPOINT = ''
# OTLP 额外请求头（key=value,key2=value2）
OTEL_OTLP_HEADERS = ''
# OTLP 上报超时（毫秒）
OTEL_EXPORTER_TIMEOUT_MS = 10000
# 是否启用 ConsoleSpanExporter
OTEL_CONSOLE_EXPORTER = false
# FastAPI 排除追踪 URL（逗号分隔）
OTEL_EXCLUDED_URLS = '/health,/ready,/metrics,/docs,/redoc,/openapi.json'
