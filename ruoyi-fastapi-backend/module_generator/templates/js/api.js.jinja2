import request from '@/utils/request'

// 查询{{ functionName }}列表
export function list{{ BusinessName }}(query) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/list',
    method: 'get',
    params: query
  })
}

// 查询{{ functionName }}详细
export function get{{ BusinessName }}({{ pkColumn.python_field }}) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/' + {{ pkColumn.python_field }},
    method: 'get'
  })
}

// 新增{{ functionName }}
export function add{{ BusinessName }}(data) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}',
    method: 'post',
    data: data,
    feedback: { mode: 'auto', key: '{{ moduleName }}.{{ businessName }}.create' }
  })
}

// 修改{{ functionName }}
export function update{{ BusinessName }}(data) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}',
    method: 'put',
    data: data,
    feedback: { mode: 'auto', key: '{{ moduleName }}.{{ businessName }}.update' }
  })
}

// 删除{{ functionName }}
export function del{{ BusinessName }}({{ pkColumn.python_field }}) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/' + {{ pkColumn.python_field }},
    method: 'delete',
    feedback: { mode: 'auto', key: '{{ moduleName }}.{{ businessName }}.delete' }
  })
}
