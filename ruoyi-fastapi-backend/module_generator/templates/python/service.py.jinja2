    @classmethod
    async def get_{{ businessName }}_list_services(
        cls, query_db: AsyncSession, query_object: {{ BusinessName }}PageQueryModel, is_page: bool = False
    ):
        """
        获取{{ functionName }}列表信息service

        :param query_db: orm对象
        :param query_object: 查询参数对象
        :param is_page: 是否开启分页
        :return: {{ functionName }}列表信息对象
        """
        {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
        {{ businessName }}_list_result = await {{ businessName }}_repo.get_{{ businessName }}_list(query_object, is_page)

        {% if hasReadModel %}
        rows = {{ businessName }}_list_result.items if is_page else {{ businessName }}_list_result
        models = [{{ BusinessName }}ReadModel.model_validate(row) for row in rows]
        {% if hasAssets %}
        await cls._attach_assets(query_db, models)
        {% endif %}
        items = [model.model_dump(by_alias=True) for model in models]
        if is_page:
            {{ businessName }}_list_result.items = items
        else:
            {{ businessName }}_list_result = items
        {% endif %}
        return {{ businessName }}_list_result

    {% for column in columns %}
    {% set parentheseIndex = column.column_comment.find("（") %}
    {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
    {% if column.unique %}
    @classmethod
    async def check_{{ column.python_field | camel_to_snake }}_unique_services(cls, query_db: AsyncSession, page_object: {{ BusinessName }}Model):
        """
        检查{{ comment }}是否唯一service

        :param query_db: orm对象
        :param page_object: {{ functionName }}对象
        :return: 校验结果
        """
        {{ pk_field }} = -1 if page_object.{{ pk_field }} is None else page_object.{{ pk_field }}
        {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
        {{ businessName }} = await {{ businessName }}_repo.get_{{ businessName }}_detail_by_info(
            {{ BusinessName }}Model({{ column.python_field }}=page_object.{{ column.python_field | camel_to_snake }})
        )
        if {{ businessName }} and {{ businessName }}.{{ pk_field }} != {{ pk_field }}:
            return CommonConstant.NOT_UNIQUE
        return CommonConstant.UNIQUE
    {% if not loop.last %}{{ "\n" }}{% endif %}
    {% endif %}
    {% endfor %}

    @classmethod
    async def add_{{ businessName }}_services(cls, query_db: AsyncSession, page_object: {{ BusinessName }}Model{% if hasAssets %}, actor: Actor{% endif %}):
        """
        新增{{ functionName }}信息service

        :param query_db: orm对象
        :param page_object: 新增{{ functionName }}对象
        :return: 新增{{ functionName }}校验结果
        """
        {% for column in columns %}
        {% set parentheseIndex = column.column_comment.find("（") %}
        {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
        {% if column.unique %}
        if not await cls.check_{{ column.python_field | camel_to_snake }}_unique_services(query_db, page_object):
            raise ServiceException(message=f'新增{{ functionName }}{page_object.{{ column.python_field | camel_to_snake }}}失败，{{ comment }}已存在')
        {% endif %}
        {% endfor %}
        {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
        try:
            {% if table.sub %}
            add_{{ businessName }} = await {{ businessName }}_repo.add_{{ businessName }}(page_object)
            if add_{{ businessName }}:
                for sub_table in page_object.{{ subclassName }}_list:
                    sub_table.{{ subTableFkName }} = add_{{ businessName }}.{{ pk_field }}
                    await {{ businessName }}_repo.add_{{ subTable.business_name }}(sub_table)
            created_{{ pk_field }} = add_{{ businessName }}.{{ pk_field }}
            {% else %}
            add_{{ businessName }} = await {{ businessName }}_repo.add_{{ businessName }}(page_object)
            created_{{ pk_field }} = add_{{ businessName }}.{{ pk_field }}
            {% endif %}
            {% if hasAssets %}
            await cls._save_assets(query_db, actor, page_object, created_{{ pk_field }}, creating=True)
            {% endif %}
            await query_db.commit()
            return await cls.{{ businessName }}_detail_services(query_db, created_{{ pk_field }})
        except Exception as e:
            await query_db.rollback()
            raise e

    @classmethod
    async def edit_{{ businessName }}_services(cls, query_db: AsyncSession, page_object: {{ BusinessName }}Model{% if hasAssets %}, actor: Actor{% endif %}):
        """
        编辑{{ functionName }}信息service

        :param query_db: orm对象
        :param page_object: 编辑{{ functionName }}对象
        :return: 编辑{{ functionName }}校验结果
        """
        edit_{{ businessName }} = page_object.model_dump(exclude_unset=True, exclude={% raw %}{{% endraw %}{% if table.sub %}'{{ subclassName }}_list', {% endif %}{% for field in assetFields %}'{{ field.attr }}', {% endfor %}{% for column in columns %}{% if not column.edit and not column.pk and column.column_name not in column_not_edit_show %}'{{ column.python_field | camel_to_snake  }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}{% raw %}}{% endraw %})
        {{ businessName }}_info = await cls.{{ businessName }}_detail_services(query_db, page_object.{{ pk_field }})
        if {{ businessName }}_info.{{ pk_field }}:
            {% for column in columns %}
            {% set parentheseIndex = column.column_comment.find("（") %}
            {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
            {% if column.unique %}
            if not await cls.check_{{ column.python_field | camel_to_snake }}_unique_services(query_db, page_object):
                raise ServiceException(message=f'修改{{ functionName }}{page_object.{{ column.python_field | camel_to_snake }}}失败，{{ comment }}已存在')
            {% endif %}
            {% endfor %}
            {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
            try:
                {% if hasAssets %}
                # A concurrent delete may have committed after the read above; never bind files to a missing owner.
                if await {{ businessName }}_repo.lock_{{ businessName }}(page_object.{{ pk_field }}) is None:
                    raise ServiceException(message='{{ functionName }}不存在')
                {% endif %}
                await {{ businessName }}_repo.edit_{{ businessName }}(edit_{{ businessName }})
                {% if table.sub %}
                for sub_table in {{ businessName }}_info.{{ subclassName }}_list:
                    await {{ businessName }}_repo.delete_{{ subTable.business_name }}(sub_table)
                for sub_table in page_object.{{ subclassName }}_list:
                    sub_table.{{ subTableFkName }} = page_object.{{ pk_field }}
                    await {{ businessName }}_repo.add_{{ subTable.business_name }}(sub_table)
                {% endif %}
                {% if hasAssets %}
                await cls._save_assets(query_db, actor, page_object, page_object.{{ pk_field }}, creating=False)
                {% endif %}
                await query_db.commit()
                return await cls.{{ businessName }}_detail_services(query_db, page_object.{{ pk_field }})
            except Exception as e:
                await query_db.rollback()
                raise e
        else:
            raise ServiceException(message='{{ functionName }}不存在')

    @classmethod
    async def delete_{{ businessName }}_services(cls, query_db: AsyncSession, page_object: Delete{{ BusinessName }}Model):
        """
        删除{{ functionName }}信息service

        :param query_db: orm对象
        :param page_object: 删除{{ functionName }}对象
        :return: 删除{{ functionName }}校验结果
        """
        if page_object.{{ pk_field }}s:
            {{ pk_field }}_list = page_object.{{ pk_field }}s.split(',')
            {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
            try:
                for {{ pk_field }} in {{ pk_field }}_list:
                    {% if hasAssets %}
                    # Deleting the owner releases its file bindings in the same transaction (lock owner first).
                    await {{ businessName }}_repo.lock_{{ businessName }}(int({{ pk_field }}))
                    await get_binding_service().release_owner(query_db, OwnerRef.of(OWNER_TYPE, int({{ pk_field }})))
                    {% endif %}
                    {% if table.sub %}
                    {{ businessName }} = await cls.{{ businessName }}_detail_services(query_db, int({{ pk_field }}))
                    for sub_table in {{ businessName }}.{{ subclassName }}_list:
                        await {{ businessName }}_repo.delete_{{ subTable.business_name }}(sub_table)
                    {% endif %}
                    await {{ businessName }}_repo.delete_{{ businessName }}(
                        {{ BusinessName }}Model({{ pkField }}={{ pk_field }})
                    )
                await query_db.commit()
                return None
            except Exception as e:
                await query_db.rollback()
                raise e
        else:
            raise ServiceException(message='传入{{ pk_field_comment }}为空')

    @classmethod
    async def {{ businessName }}_detail_services(cls, query_db: AsyncSession, {{ pk_field }}: int):
        """
        获取{{ functionName }}详细信息service

        :param query_db: orm对象
        :param {{ pk_field }}: {{ pk_field_comment }}
        :return: {{ pk_field_comment }}对应的信息
        """
        {{ businessName }}_repo = {{ BusinessName }}Repository(query_db)
        {{ businessName }} = await {{ businessName }}_repo.get_{{ businessName }}_detail_by_id({{ pk_field }})
        if {{ businessName }}:
            result = {% if hasReadModel %}{{ BusinessName }}ReadModel.model_validate({{ businessName }}){% else %}{{ BusinessName }}Model(**CamelCaseUtil.transform_result({{ businessName }})){% endif %}{{ '\n' }}
            {% if hasAssets %}
            await cls._attach_assets(query_db, [result])
            {% endif %}
        else:
            result = {{ BusinessName }}Model(**dict())

        return result

{% if hasAssets %}
    @classmethod
    async def _attach_assets(cls, query_db: AsyncSession, models: List[{{ BusinessName }}ReadModel]):
        """
        批量读投影：文件ID来自绑定关系（每个字段一次查询），不读取业务列

        :param query_db: orm对象
        :param models: {{ functionName }}读模型列表
        """
        owner_ids = [model.{{ pk_field }} for model in models if model.{{ pk_field }} is not None]
        if not owner_ids:
            return
        bindings = get_binding_service()
        {% for field in assetFields %}
        {{ field.attr }} = await bindings.project(query_db, OWNER_TYPE, owner_ids, '{{ field.name }}')
        {% endfor %}
        for model in models:
            owner_id = str(model.{{ pk_field }})
            {% for field in assetFields %}
            model.{{ field.attr }} = [asset.asset_id for asset in {{ field.attr }}.get(owner_id, [])]
            {% endfor %}

    @classmethod
    async def _save_assets(
        cls, query_db: AsyncSession, actor: Actor, page_object: {{ BusinessName }}Model, {{ pk_field }}: int, *, creating: bool
    ):
        """
        在当前业务事务内替换文件字段：未提供表示不修改，[] 表示清空；由调用方统一提交或回滚

        :param query_db: orm对象
        :param actor: 当前用户授权快照
        :param page_object: {{ functionName }}对象
        :param {{ pk_field }}: {{ pk_field_comment }}
        :param creating: 是否为新建
        """
        owner = OwnerRef.of(OWNER_TYPE, {{ pk_field }})
        bindings = get_binding_service()
        provided = page_object.model_fields_set
        {% for field in assetFields %}
        {% if field.required %}
        if (creating or '{{ field.attr }}' in provided) and not page_object.{{ field.attr }}:
            raise ServiceException(message='{{ field.label }}不能为空')
        {% endif %}
        if '{{ field.attr }}' in provided and page_object.{{ field.attr }} is not None:
            await bindings.replace_field_assets(
                query_db, actor, owner, '{{ field.name }}', page_object.{{ field.attr }}, creating=creating
            )
        {% endfor %}

{% endif %}
    @staticmethod
    async def export_{{ businessName }}_list_services({% if dicts %}request: Request, {% endif %}{{ businessName }}_list: List):
        """
        导出{{ functionName }}信息service

        :param {{ businessName }}_list: {{ functionName }}信息列表
        :return: {{ functionName }}信息对应excel的二进制数据
        """
        # 创建一个映射字典，将英文键映射到中文键
        mapping_dict = {
            {% for column in columns %}
            {% set parentheseIndex = column.column_comment.find("（") %}
            {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
            '{{ column.python_field }}': '{{ comment }}',
            {% endfor %}
        }
        {% if dicts %}
        dict_data_service = DictDataService()
        {% for dict_type in dicts.split(", ") %}
        {{ dict_type[1:-1] }}_list = await dict_data_service.query_dict_data_list_from_cache_services(
            request.app.state.redis, dict_type={{ dict_type }}
        )
        {{ dict_type[1:-1] }}_option = [dict(label=item.get('dictLabel'), value=item.get('dictValue')) for item in {{ dict_type[1:-1] }}_list]
        {{ dict_type[1:-1] }}_option_dict = {item.get('value'): item for item in {{ dict_type[1:-1] }}_option}
        {% endfor %}
        for item in {{ businessName }}_list:
            {% for column in columns %}
            {% if column.dict_type %}
            if str(item.get('{{ column.python_field }}')) in {{ column.dict_type }}_option_dict.keys():
                item['{{ column.python_field }}'] = {{ column.dict_type }}_option_dict.get(str(item.get('{{ column.python_field }}'))).get('label')
            {% endif %}
            {% endfor %}
        {% endif %}
        {% for column in remarkColumns %}
        for item in {{ businessName }}_list:
            item['{{ column.python_field }}'] = remark_display_text(item.get('{{ column.python_field }}'))
        {% endfor %}
        {% if hasAssets %}
        # File fields are relations, not exported cells.
        for item in {{ businessName }}_list:
            for key in ASSET_FIELDS:
                item.pop(key, None)
        {% endif %}
        binary_data = ExcelUtil.export_list2excel({{ businessName }}_list, mapping_dict{% if remarkColumns %}, text_columns={% raw %}{{% endraw %}{% for column in remarkColumns %}'{{ column.python_field }}',{% endfor %}{% raw %}}{% endraw %}{% endif %})

        return binary_data
